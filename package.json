{
  "name": "narrative-provenance",
  "version": "0.1.1",
  "description": "Privacy-first provenance records for Obsidian notes",
  "main": "main.js",
  "scripts": {
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "test": "vitest run",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": ["obsidian", "provenance", "research", "writing", "rights"],
  "author": "Dominique Devereaux",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "builtin-modules": "^5.0.0",
    "esbuild": "^0.25.0",
    "obsidian": "latest",
    "tslib": "^2.8.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
